# AI Story Factory - provider keys.
#
# 1. Copy this file to ".env"   (cp .env.example .env)
# 2. Paste a key after the "=" for each provider you want to use
# 3. Restart the server        (python run.py)
#
# Keys are read by the SERVER only. They are never sent to the browser.
# Leave a line empty to skip that provider. With NO keys at all the app still runs
# end to end using its built-in offline engines (lower quality, clearly labelled).
#
# Settings > Providers in the dashboard shows which keys were detected and lets you test them.

# ---------------------------------------------------------------- Story writer (LLM)
# Writes the story, characters, script and the viral critique. Also enables
# vision analysis of reference videos/images. Pick ONE (Anthropic is used first if both are set).
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1

# FREE or LOCAL writer: any service that speaks the OpenAI chat language. Pick ONE of these two examples (Settings > Story writer > "Free / local AI").
# Quality depends on the model: small local models write simpler stories than Claude and are slower.
#  a) Google Gemini (free tier, no card; get a key at https://aistudio.google.com/apikey and pick a Gemini Flash model name from AI Studio):
# OPENAI_COMPAT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# OPENAI_COMPAT_MODEL=<a Gemini Flash model name>
# OPENAI_COMPAT_API_KEY=<your Gemini key>
#  b) Ollama on your own computer (free, private, no key; install from https://ollama.com, then run "ollama pull <model>" once):
# OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1
# OPENAI_COMPAT_MODEL=<the model you pulled, for example qwen3:8b>

# ---------------------------------------------------------------- Voices (text-to-speech)
# ElevenLabs: widest choice of voices/accents, returns exact word timing for captions.
ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_multilingual_v2
# OpenAI TTS also works (uses OPENAI_API_KEY above). Word timing is estimated from the audio.
# OPENAI_TTS_MODEL=gpt-4o-mini-tts

# ---------------------------------------------------------------- Optional AI visuals
# Keyframe images for each scene (Settings > Video Renderer > "AI keyframe images").
# Uses OPENAI_API_KEY above.
# OPENAI_IMAGE_MODEL=gpt-image-1
# Image-to-video clips (Video Renderer > "AI video clips").
RUNWAY_API_KEY=
# RUNWAY_MODEL=gen4_turbo
# RUNWAY_RATIO=720:1280

# ---------------------------------------------------------------- Server
# SF_HOST=127.0.0.1
# SF_PORT=8000
# SF_DATA_DIR=./data
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe

# Advanced: point a provider at a proxy / compatible endpoint.
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# OPENAI_BASE_URL=https://api.openai.com
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io
# RUNWAY_BASE_URL=https://api.dev.runwayml.com
