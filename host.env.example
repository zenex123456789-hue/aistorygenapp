# Settings for the hosted version. On a hosting platform (Railway, Render, Fly) type these into its "Variables" page instead.
# On your own server copy this file to ".env" next to docker-compose.yml.

# REQUIRED. One personal code per person, as name:code, separated by commas. Use 12+ random characters.
# Make good ones with:  python tools/make_codes.py alice bob carol
SF_ACCESS_CODES=

# Your own API keys. They stay on the server; nobody who signs in can read them.
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
# OPENAI_API_KEY=
# RUNWAY_API_KEY=

# Video runs each person may start per day (0 = no limit). Your provider spend limits are the real safety net.
SF_DAILY_RUNS=20

# Own-server (docker compose) only: the web address people will use, already pointed at this server, e.g. story.example.com
SITE_ADDRESS=

# Optional: a read-only GitHub token (Contents: read) so signed-in friends can download the Android/iPhone files from Releases. Stays on the server.
# SF_UPDATE_TOKEN=
